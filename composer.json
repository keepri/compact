{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "boilerplate/laravel-filament",
    "type": "project",
    "description": "Laravel 12 boilerplate with Filament v4, Livewire 3, Tailwind CSS v4 and a centralized branding system.",
    "keywords": ["laravel", "framework", "boilerplate"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "bezhansalleh/filament-language-switch": "^4.0",
        "filament/filament": "^4.6",
        "laravel/framework": "^12.36",
        "laravel/tinker": "^2.10",
        "league/flysystem-aws-s3-v3": "^3.0",
        "livewire/livewire": "^3.6",
        "spatie/laravel-translatable": "^6.12"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "driftingly/rector-laravel": "^2.1",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^1.8",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.3",
        "rector/rector": "^2.3",
        "sebastian/environment": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan storage:link",
            "@php artisan migrate --force --seed",
            "npm install",
            "npm run build"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php -r \"if (is_dir('vendor/barryvdh/laravel-ide-helper')) { passthru('php artisan ide-helper:generate'); passthru('php artisan ide-helper:models -RW'); if (file_exists('vendor/bin/pint')) { passthru('vendor/bin/pint app/Models --quiet'); } }\"",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "format:check": [
            "@php vendor/bin/pint --test",
            "npm run format:check"
        ],
        "format": [
            "@php vendor/bin/pint",
            "npm run format"
        ],
        "rector": [
            "vendor/bin/rector",
            "vendor/bin/pint"
        ],
        "refactor:check": [
            "vendor/bin/rector --dry-run"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
