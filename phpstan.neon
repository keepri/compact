includes:
    - vendor/larastan/larastan/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    # Level 9 = full null-safety, missing-type checks, and explicit-mixed
    # checking. Raise it, never lower it: a level is only worth having if the
    # whole repository is clean at it, and dropping back hides the errors you
    # already paid to fix. Fix the code instead of adding ignores or baselines.
    #
    # Getting here meant narrowing every config()/env() read that flowed as
    # mixed into a typed parameter - prefer Illuminate\Support\Facades\Config's
    # typed accessors (::string(), ::array(), ::integer(), ...) at those call
    # sites, or an is_string()/is_array() runtime guard where no typed
    # accessor exists (e.g. Session::get()).
    level: 9

    paths:
        - app/
        - bootstrap/
        - config/
        - database/
        - routes/
        # tests/ is deliberately not analysed: Pest's `$this` inside a test
        # closure is bound at runtime, so every `$this->get(...)` reads as
        # method.notFound, and its fluent expectation API is marked @internal.
        # Analysing them means ~60 false positives and zero real findings.

    excludePaths:
        # Generated by barryvdh/laravel-ide-helper on every composer install.
        - _ide_helper.php
        - _ide_helper_models.php

    tmpDir: storage/framework/cache/phpstan

    ignoreErrors:
        # `ide-helper:models -RW` rewrites the model docblocks on every composer
        # install, and it emits spatie/laravel-translatable's `array` parameters
        # and properties without a value type. A hand fix does not survive the
        # next regeneration, so ignore exactly those generated tags.
        -
            identifier: missingType.iterableValue
            message: '#PHPDoc tag @(method|property-read) .*(\$locales|\$translatable_columns_from)#'
            path: app/Models/*
