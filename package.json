{
    "name": "laravel-filament-boilerplate",
    "description": "The website of Compact, built on Laravel 12, Filament v4, Livewire 3 and Tailwind CSS v4.",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "clean": "rm -fr node_modules vendor",
        "clean-install": "npm run clean && npm i & composer i",
        "format": "blade-formatter \"./resources/**/*.blade.php\" -w",
        "format:check": "blade-formatter \"./resources/**/*.blade.php\" --check-formatted --diff"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.0",
        "concurrently": "^9.2.1",
        "laravel-vite-plugin": "^2.1.0",
        "tailwindcss": "^4.3.0",
        "vite": "^7.3.5"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.0",
        "lightningcss-linux-x64-gnu": "^1.32.0"
    },
    "devDependencies": {
        "blade-formatter": "^1.44.4"
    }
}
